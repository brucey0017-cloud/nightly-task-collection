#!/usr/bin/env python3
"""jsonl-guard: validate JSON Lines files quickly."""

from __future__ import annotations

import argparse
import json
import os
import sys
from dataclasses import dataclass
from typing import List


@dataclass
class LineError:
    line_no: int
    message: str


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="jsonl-guard",
        description="Validate a .jsonl file and report line-level parse errors.",
    )
    parser.add_argument("path", help="Path to .jsonl file to validate")
    parser.add_argument(
        "--max-errors",
        type=int,
        default=20,
        help="Maximum number of invalid lines to print (default: 20)",
    )
    return parser.parse_args()


def validate_jsonl(path: str, max_errors: int) -> tuple[int, int, List[LineError]]:
    total = 0
    valid = 0
    errors: List[LineError] = []

    with open(path, "r", encoding="utf-8") as f:
        for idx, raw in enumerate(f, start=1):
            total += 1
            line = raw.rstrip("\n")
            if line.strip() == "":
                if len(errors) < max_errors:
                    errors.append(LineError(idx, "empty line is not valid JSON"))
                continue

            try:
                json.loads(line)
                valid += 1
            except json.JSONDecodeError as e:
                if len(errors) < max_errors:
                    errors.append(LineError(idx, f"{e.msg} (col {e.colno})"))

    return total, valid, errors


def print_report(path: str, total: int, valid: int, errors: List[LineError], max_errors: int) -> None:
    invalid = total - valid

    if invalid == 0:
        print("What happened: ✓ JSONL validation passed.")
    else:
        print("What happened: x JSONL validation failed.")

    print("\nKey facts:")
    print(f"- ✓ File: {path}")
    print(f"- ✓ Total lines: {total}")
    print(f"- ✓ Valid lines: {valid}")
    if invalid == 0:
        print("- ✓ Invalid lines: 0")
    else:
        print(f"- ! Invalid lines: {invalid}")
        shown = len(errors)
        print(f"- ! Showing first {shown} invalid line(s) (max-errors={max_errors})")
        for err in errors:
            print(f"  - line {err.line_no}: {err.message}")

    print("\nNext command:")
    if invalid == 0:
        print(f"python3 {os.path.abspath(sys.argv[0])} {path}")
    else:
        print(f"python3 {os.path.abspath(sys.argv[0])} {path} --max-errors {max_errors * 2}")


def main() -> int:
    args = parse_args()

    if args.max_errors <= 0:
        print("x --max-errors must be > 0", file=sys.stderr)
        return 2

    if not os.path.exists(args.path):
        print("What happened: x JSONL validation failed.")
        print("\nKey facts:")
        print(f"- x File not found: {args.path}")
        print("\nNext command:")
        print(f"ls -la {os.path.dirname(args.path) or '.'}")
        return 2

    if not os.path.isfile(args.path):
        print("What happened: x JSONL validation failed.")
        print("\nKey facts:")
        print(f"- x Not a regular file: {args.path}")
        print("\nNext command:")
        print(f"file {args.path}")
        return 2

    try:
        total, valid, errors = validate_jsonl(args.path, args.max_errors)
    except OSError as e:
        print("What happened: x JSONL validation failed.")
        print("\nKey facts:")
        print(f"- x I/O error: {e}")
        print("\nNext command:")
        print(f"ls -la {os.path.dirname(args.path) or '.'}")
        return 2

    print_report(args.path, total, valid, errors, args.max_errors)

    if (total - valid) == 0:
        if sys.stdout.isatty():
            print("\nDone. You can trust this run.")
        return 0

    return 1


if __name__ == "__main__":
    raise SystemExit(main())
